# Hosted Eigen configuration. Store actual values in Render secrets or ignored .env.
EIGEN_HOSTED=true
EIGEN_PUBLIC_ORIGIN=https://YOUR-WEB-SERVICE.onrender.com
# Comma-separated invited Neon user IDs or verified email addresses.
EIGEN_INVITED_USERS=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM accepts quoted newlines or literal \n escapes.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Both web and worker must use the same persistent key.
EIGEN_TOKEN_KEY=
E2B_API_KEY=
E2B_TEMPLATE=base
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional coding/evaluation model override for newly created projects.
EIGEN_CODING_MODEL=
# RENDER_API_KEY is deployment tooling only, not a web/worker runtime setting.
# Neon sign-in's GITHUB_OAUTH_CLIENT_ID/SECRET are distinct from GitHub App values.
# No live payment credentials are accepted or needed.
